# Staging — Supabase + Vercel (validación cliente)
# Opción A: npm run staging:bootstrap (ver docs/DEPLOY_STAGING.md)
# Opción B: copia a `.env.staging` y rellena manualmente

NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://tu-proyecto.vercel.app

# ─── Base de datos (Supabase Postgres) ───────────────
DATABASE_DRIVER=postgres
# Local/setup: conexión directa 5432. Vercel: pooler 6543 (Transaction)
DATABASE_URL=postgresql://postgres:[password]@aws-1-eu-west-2.pooler.supabase.com:5432/postgres

# ─── Drivers cloud ─────────────────────────────────────
STORAGE_DRIVER=supabase
AUTH_DRIVER=supabase

# ─── Storage Supabase ──────────────────────────────────
STORAGE_PUBLIC_BASE=https://pmvvnfjiccmxwrilmqnl.supabase.co/storage/v1/object/public/media
SUPABASE_STORAGE_BUCKET=media

# ─── Supabase ──────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://pmvvnfjiccmxwrilmqnl.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── Tenant ────────────────────────────────────────────
FUNERAL_HOME_ID=fh-001

# ─── Sesiones JWT (generar secrets únicos ≥32 chars) ───
ADMIN_SESSION_SECRET=cambia-esto-por-un-secret-largo-para-staging
FAMILY_SESSION_SECRET=cambia-esto-por-otro-secret-largo-staging

# ─── Seed admin (setup-staging-db.ts crea el usuario si falta) ───
SEED_ADMIN_EMAIL=admin@staging.pujols.cat
# SEED_ADMIN_PASSWORD=opcional; si vacío, se genera al ejecutar db:setup:staging
# SEED_ADMIN_AUTH_USER_ID=lo rellena setup-staging-db.ts automáticamente

# ─── Google Places (opcional) ──────────────────────────
# GOOGLE_MAPS_API_KEY=
