{
  "name": "funeraria",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:setup": "tsx --env-file=.env.development scripts/setup-db.ts",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx --env-file=.env.development scripts/seed.ts",
    "db:reset": "tsx --env-file=.env.development scripts/reset-db.ts",
    "db:studio": "drizzle-kit studio",
    "db:push:staging": "drizzle-kit push --config drizzle.config.prod.ts",
    "db:seed:staging": "tsx --env-file=.env.staging scripts/seed.ts",
    "staging:bootstrap": "tsx scripts/bootstrap-staging-env.ts",
    "staging:setup": "npm run staging:bootstrap && npm run db:setup:staging",
    "db:setup:staging": "tsx --env-file=.env.staging scripts/setup-staging-db.ts",
    "storage:clean": "tsx scripts/clean-storage.ts",
    "guia:imprimible:ca": "node scripts/build-guia-imprimible-ca.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "better-sqlite3": "^11.10.0",
    "drizzle-orm": "^0.44.2",
    "jose": "^6.0.11",
    "mime-types": "^3.0.1",
    "next": "16.2.10",
    "next-intl": "^4.13.1",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.20.3",
    "typescript": "^5"
  }
}
